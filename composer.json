{
    "name": "h3php/minimax-h3",
    "description": "MiniMax-H3 Video Generation Engine — PHP CLI (compiled to standalone binary via TypePHP)",
    "type": "project",
    "license": "MIT",
    "bin": ["bin/h3php.php"],
    "autoload": {
        "psr-4": {
            "H3Php\\": "php-src"
        }
    },
    "require": {
        "php": ">=8.4 <8.6",
        "composer-runtime-api": "^2.2",
        "swoole/typephp": "^0.7.0",
        "symfony/var-dumper": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "start": "php bin/h3php.php",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "test": "phpunit --configuration=phpunit.xml",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "build": "tpc -j8 -m bin -o h3php project.yml",
        "post-autoload-dump": [
            "@php patch.php"
        ]
    }
}
