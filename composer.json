{
    "name": "h3php/minimax-h3",
    "description": "MiniMax-H3 Video Generation Engine — Cross-platform PHP CLI with Qt GUI (macOS/Windows/Linux)",
    "type": "project",
    "license": "MIT",
    "bin": ["bin/h3php.php"],
    "autoload": {
        "psr-4": {
            "H3Php\\": "php-src"
        }
    },
    "require": {
        "php": ">=8.5 <8.6",
        "composer-runtime-api": "^2.2",
        "swoole/typephp": "^0.7.0",
        "symfony/var-dumper": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "pestphp/pest": "^5.1"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "start": "php bin/h3php.php",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "test": "pest",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "build": "bash build_native.sh",
        "build:macos": "bash build_native.sh",
        "build:windows": "cmd /c build_windows.bat",
        "build:linux": "bash build_linux.sh",
        "post-autoload-dump": [
            "@php patch.php"
        ]
    }
}
